# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Godot's text formats stay diffable — .tres and .tscn are reviewed like code
# (DESIGN.md §6.1: data-driven everything, diffable in git).
*.gd     text eol=lf
*.tres   text eol=lf
*.tscn   text eol=lf
*.godot  text eol=lf
*.json   text eol=lf

# Binary sources go through Git LFS (Appendix A step 1). .blend files are the
# authoritative art sources and live in-repo under LFS (ADR-003).
*.blend  filter=lfs diff=lfs merge=lfs -text
*.blend1 filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text
*.ogg    filter=lfs diff=lfs merge=lfs -text
*.png    filter=lfs diff=lfs merge=lfs -text

# Vendored third-party code is committed as plain blobs. gdUnit4 ships a
# handful of small PNGs that are not our art and should not consume the LFS
# budget, so unset the filter for everything under addons/.
addons/** !filter !diff !merge

# The walkthrough's pictures are recorded by the test suite and read on
# GitHub's rendering of the page beside them; small, regenerated, and plain
# blobs so a clone without LFS still shows them (ADR-031).
walkthrough/shots/** !filter !diff !merge -text

# The boot splash is the one PNG that has to be a real file in the tree: Godot
# reads it raw at startup and accepts nothing but PNG, and an LFS pointer there
# is Godot's own logo on every fresh clone. Rendered from icon.svg by
# tools/make_icons.gd and committed; the header there says why.
art/icon/boot_splash.png !filter !diff !merge
