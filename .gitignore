# Godot 4+ specific ignores
.godot/
/android/

# Export artifacts. `export_presets.cfg` is tracked -- see the note at the top of
# it: the keystore fields are empty and supplied by environment variables, so it
# carries no secrets and no machine-local paths, and a build nobody else can
# reproduce is not a build.
/build/
/exports/

# gdUnit4 writes run reports here.
/reports/

# OS and editor cruft
.DS_Store
Thumbs.db
