; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="golfVs"
config/version="0.0.1-m0"
run/main_scene="res://ui/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
run/flush_stdout_on_print=true
config/icon="res://icon.svg"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[golfvs]

engine/pinned_godot_version="4.7.2.stable"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
; Required for the Android export, which refuses to run without it, and correct
; regardless: ETC2/ASTC is what mobile GPUs sample natively (ADR-007 makes a
; phone the reference device). Desktop keeps S3TC/BPTC through the same import.
textures/vram_compression/import_etc2_astc=true
