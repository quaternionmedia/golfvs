; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="golfVs"
config/version="0.0.1"
run/main_scene="res://ui/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
run/flush_stdout_on_print=true
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; Landscape, said out loud, and sensor-landscape rather than plain landscape so
; the phone can be held either way up. ADR-007 makes the phone the reference
; device; a golf shot is a horizontal thing and the range is wider than deep.
;
; It was already landscape, because that is Godot's default -- and Godot strips
; settings equal to their default when the editor saves, so writing plain
; landscape here would have silently vanished, the way
; `physics/common/physics_ticks_per_second` was found to. 4 is sensor-landscape,
; which is both the better behaviour and a value that survives.
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[golfvs]

engine/pinned_godot_version="4.7.2.stable"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
; Required for the Android export, which refuses to run without it, and correct
; regardless: ETC2/ASTC is what mobile GPUs sample natively (ADR-007 makes a
; phone the reference device). Desktop keeps S3TC/BPTC through the same import.
textures/vram_compression/import_etc2_astc=true
